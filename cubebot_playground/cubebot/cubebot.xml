<mujoco model="cubebot">
  <!-- Scale all body masses and inertias proportionally to 1 kg total. -->
  <compiler angle="radian" settotalmass="1.0"/>

  <!-- ========================================================= -->
  <!-- DEFAULTS                                                  -->
  <!-- ========================================================= -->

  <default>

    <!--
      Visual STL geometry.
      Does NOT participate in collisions.
      group=2 allows visual geometry to be hidden separately.
    -->
    <default class="visual">
      <geom
        contype="0"
        conaffinity="0"
        group="2"/>
    </default>

    <!--
      Physical collision geometry.

      group=3 allows us to show/hide all collision geometry
      from the MuJoCo viewer.

      Keep it semi-transparent while setting up the model.
      Later it can simply be hidden by disabling geom group 3.
    -->
    <default class="collision">
      <geom
        contype="1"
        conaffinity="1"
        group="3"
        rgba="1 0 0 0.30"/>
    </default>

  </default>


